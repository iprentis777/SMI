index 134fe48..7addba6 100644
--- a/deconv_comparison/mc_config.m
+++ b/deconv_comparison/mc_config.m
@@ -32,6 +32,7 @@ function C = mc_config()
 %   C.rotate_about(n,deg) a unit vector `deg` degrees from n, in a fixed plane
 
 C = struct();
+C.PROTOCOL   = 'hcp_real_3shell.txt';
 C.LMAX_FIT   = 6;
 C.LMAX_GT    = 8;
 C.CS_PHASE   = 0;
@@ -49,6 +50,44 @@ C.AXIS1 = n1/norm(n1);
